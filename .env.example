# ── x402 Payment Config ──────────────────────────────────────
# Wallet that receives USDC payments (Base mainnet)
SELLER_ADDRESS=0x3237b37397094b9a3b48a9aac8f627ac654b927c

# Circle Gateway facilitator (mainnet)
FACILITATOR_URL=https://gateway-api.circle.com

# Payment networks (Base mainnet = eip155:8453)
X402_NETWORKS=eip155:8453

# ── Pricing (in dollars, converted to atomic USDC at runtime) ──
PRICE_SECTOR_SUMMARY=0.01
PRICE_LEADERBOARD_BASIC=0.02
PRICE_LEADERBOARD_FULL=0.15
PRICE_WALLET_LOOKUP_FULL=0.05

# ── Octav API (optional — enables cross-chain net worth enrichment) ──
OCTAV_API_KEY=

# ── Cache TTLs (seconds) ─────────────────────────────────────
CACHE_TTL_LEADERBOARD=1200
CACHE_TTL_POSITIONS=1200
CACHE_TTL_OCTAV=43200

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# ── Server ───────────────────────────────────────────────────
PORT=3001
